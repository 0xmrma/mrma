{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xmrma.github.io/mrma/schemas/benchmark-v1.schema.json",
  "title": "MRMA expert benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_version",
    "mrma_version",
    "passed",
    "case_count",
    "false_positive_count",
    "false_negative_count",
    "inconclusive_count",
    "request_cost",
    "runtime_ms",
    "peak_memory_bytes",
    "platform",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "mrma.benchmark/v1" },
    "corpus_version": { "const": "expert-loopback-corpus/1.0" },
    "mrma_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "passed": { "type": "boolean" },
    "case_count": { "type": "integer", "minimum": 1 },
    "false_positive_count": { "type": "integer", "minimum": 0 },
    "false_negative_count": { "type": "integer", "minimum": 0 },
    "inconclusive_count": { "type": "integer", "minimum": 0 },
    "request_cost": { "type": "integer", "minimum": 0 },
    "runtime_ms": { "type": "number", "minimum": 0 },
    "peak_memory_bytes": { "type": "integer", "minimum": 0 },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "implementation", "operating_system", "machine"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "machine": { "type": "string", "minLength": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "expected_verdict",
          "actual_verdict",
          "request_cost",
          "runtime_ms",
          "passed"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "expected_verdict": { "type": "string", "minLength": 1 },
          "actual_verdict": { "type": "string", "minLength": 1 },
          "request_cost": { "type": "integer", "minimum": 0 },
          "runtime_ms": { "type": "number", "minimum": 0 },
          "passed": { "type": "boolean" }
        }
      }
    }
  }
}
